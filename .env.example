# Journey OS — Environment Variables
# Copy to .env.local and fill in all values before running
# NEVER commit .env.local to git

# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://[project-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...  # anon key (public — RLS enforced)
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # service role (server-only — bypasses RLS)
SUPABASE_DB_URL=postgresql://postgres:[pass]@[project-id].pooler.supabase.com:6543/postgres?pgbouncer=true
SUPABASE_DB_DIRECT_URL=postgresql://postgres:[pass]@[project-id].supabase.com:5432/postgres
SUPABASE_PROJECT_ID=[project-id]      # from dashboard URL

# ── Neo4j Aura ────────────────────────────────────────────────────
NEO4J_URI=neo4j+s://[instance-id].databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=[your-password]

# ── Anthropic ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_SONNET=claude-sonnet-4-20250514
ANTHROPIC_MODEL_HAIKU=claude-haiku-4-5-20251001

# ── OpenAI (embeddings only) ──────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── MedCPT (biomedical embeddings sidecar) ────────────────────────
MEDCPT_API_URL=http://localhost:8001   # local Docker sidecar
# Production: MEDCPT_API_URL=https://medcpt-[id].railway.app

# ── UMLS (medical terminology) ────────────────────────────────────
UMLS_API_KEY=[your-umls-key]           # free from uts.nlm.nih.gov
UMLS_API_URL=https://uts-ws.nlm.nih.gov/rest

# ── Inngest (workflow orchestration) ──────────────────────────────
INNGEST_SIGNING_KEY=signkey-...        # from Inngest dashboard
INNGEST_EVENT_KEY=...                  # from Inngest dashboard
INNGEST_BASE_URL=http://localhost:8288 # dev mode local URL

# ── Sidecars (document rendering) ────────────────────────────────
PPTX_RENDERER_URL=http://localhost:5000  # python-pptx Flask sidecar
PDF_RENDERER_URL=http://localhost:5001   # pdf2image Flask sidecar
METAMAP_URL=http://localhost:8080        # MetaMap NLP Java service

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Email (notifications) ─────────────────────────────────────────
RESEND_API_KEY=re_...

# ── OCR configuration ─────────────────────────────────────────────
OCR_ENABLED=true
OCR_MIN_BODY_CHARS=50        # below this → tesseract fallback for scanned PDFs
OCR_MIN_ENTITY_DENSITY=0.1   # below this AND has_image → Vision OCR

# ── Generation limits ─────────────────────────────────────────────
GENERATION_MAX_CONCURRENT=3   # max concurrent P3 runs per faculty
GENERATION_DAILY_LIMIT=100    # max items per faculty per day
