  "institutional_learning_objectives": [
    { "id": "msm_ilo_01", "domain": "Medical Knowledge", "text": "Apply knowledge of normal and abnormal human structure, function, and development to clinical reasoning" },
    { "id": "msm_ilo_02", "domain": "Medical Knowledge", "text": "Integrate biochemical, immunologic, pharmacologic, and microbiologic principles in understanding disease" },
    { "id": "msm_ilo_03", "domain": "Medical Knowledge", "text": "Apply principles of epidemiology and biostatistics to evidence-based practice" },
    { "id": "msm_ilo_04", "domain": "Medical Knowledge", "text": "Recognize the impact of social determinants on health and disease" },
    { "id": "msm_ilo_05", "domain": "Clinical Skills", "text": "Perform a complete history and physical examination" },
    { "id": "msm_ilo_06", "domain": "Clinical Skills", "text": "Analyze clinical presentations and develop differential diagnoses" },
    { "id": "msm_ilo_07", "domain": "Clinical Skills", "text": "Develop evidence-based diagnostic and therapeutic plans" },
    { "id": "msm_ilo_08", "domain": "Clinical Skills", "text": "Communicate effectively with patients, families, and healthcare teams" },
    { "id": "msm_ilo_09", "domain": "Professional Attributes", "text": "Demonstrate ethical behavior and moral reasoning in clinical practice" },
    { "id": "msm_ilo_10", "domain": "Professional Attributes", "text": "Commit to service, health equity, and advocacy for underserved populations" }
  ],

